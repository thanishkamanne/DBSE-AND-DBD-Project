# APP & AI CONFIGURATION
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# BACKEND SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5157"

# MYSQL DATABASE CREDENTIALS
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="women_safety"
DB_USER="root"
DB_PASSWORD=""

# AUTHENTICATION & SECURITY
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"

# GOOGLE MAPS / PLACES API - For live nearby emergency safe places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# FRONTEND API CONFIGURATION (Vite)
# Leave blank to use Vite's dev proxy (/api -> http://localhost:5000)
# Or set explicitly for production: https://api.yourdomain.com
VITE_API_URL=
